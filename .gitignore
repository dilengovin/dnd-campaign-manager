# ---- OS / editor clutter ----
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/

# ---- Env / secrets ----
.env
.env.*
!.env.example

# ---- Logs ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Angular (frontend/) and Node (backend/, later) have their own .gitignore files
# that cover build output, node_modules, caches, etc.

# ---- Stray root lockfile ----
# There is no package.json at the repo root; npm run from here leaves an empty
# lockfile behind. Anchored to the root so frontend/package-lock.json still tracks.
/package-lock.json

# ---- Local issue tracker ----
# .scratch/<feature>/ holds specs and tickets (see AGENTS.md). Local-only by
# design: it is working context for whoever is at this checkout, not shared state.
.scratch/

# Copy to `.env` and adjust. Never commit `.env`.
#
# The service validates this on startup: if DATABASE_URL or SESSION_SECRET is
# absent, the process exits and names the one that is missing rather than
# running half-configured.

# The database the running application uses. Required.
DATABASE_URL="postgresql://dndcm:dndcm@localhost:5432/dndcm?schema=public"

# The key Sessions are signed with. Required. Placeholder only — generate your
# own with `openssl rand -base64 48` and never commit the real one.
SESSION_SECRET="replace-me-with-a-long-random-string"

# The database the test suite uses. Must not be DATABASE_URL: the suite
# truncates every table between tests.
TEST_DATABASE_URL="postgresql://dndcm:dndcm@localhost:5432/dndcm_test?schema=public"

# Port the API listens on. Optional; defaults to 3000.
PORT=3000

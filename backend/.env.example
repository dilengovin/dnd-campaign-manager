# Copy to `.env` and adjust. Never commit `.env`.

# The database the running application uses.
DATABASE_URL="postgresql://dndcm:dndcm@localhost:5432/dndcm?schema=public"

# The database the test suite uses. Must not be DATABASE_URL: the suite
# truncates every table between tests.
TEST_DATABASE_URL="postgresql://dndcm:dndcm@localhost:5432/dndcm_test?schema=public"
